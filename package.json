{
  "name": "ps-launcher",
  "productName": "PS Launcher",
  "version": "1.20.0",
  "description": "Launcher de juegos con interfaz estilo PS4",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.local.pslauncher",
    "productName": "PS Launcher",
    "files": [
      "main.js",
      "lhm.js",
      "preload.js",
      "index.html",
      "assets/**",
      "build-key.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "artifactName": "PS-Launcher.${ext}"
    },
    "asarUnpack": [
      "assets/xmb-wave.mp4"
    ]
  },
  "updateRepo": "devecchianderson12-web/LauncherPC"
}
